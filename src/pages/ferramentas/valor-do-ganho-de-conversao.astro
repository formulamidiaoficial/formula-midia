---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Badge from "../../components/ui/Badge.astro";
import Breadcrumbs from "../../components/ui/Breadcrumbs.astro";
import LeiaTambem from "../../components/ui/LeiaTambem.astro";
import ValorGanhoConversao from "../../components/islands/ValorGanhoConversao.tsx";
import { breadcrumbSchema, faqPageSchema, SITE_URL, BRAND_NAME, type FaqItem } from "../../data/schema";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Ferramentas", path: "/ferramentas" },
  { name: "Valor do Ganho de Conversão", path: "/ferramentas/valor-do-ganho-de-conversao" },
];

const faq: FaqItem[] = [
  { question: "Por que meio ponto percentual, especificamente?", answer: "Porque é um ganho realista de conquistar com ajustes de CRO (otimização de conversão) — não é uma meta exagerada, é o tipo de melhoria que um sprint de performance costuma entregar." },
  { question: "É fácil subir 0,5 ponto percentual?", answer: "Depende do ponto de partida. Sair de 1% para 1,5% costuma ser mais fácil que sair de 8% para 8,5% — quanto mais alta já é a sua conversão, mais difícil fica cada ganho adicional." },
  { question: "O que essa ferramenta não considera?", answer: "Assume tráfego constante e elasticidade nula — na prática, subir conversão às vezes exige mudar a oferta, o que pode afetar o ticket médio. Isso não está modelado aqui." },
];

const appSchema = {
  "@context": "https://schema.org", "@type": "WebApplication",
  name: "Calculadora de Valor do Ganho de Conversão",
  applicationCategory: "BusinessApplication", operatingSystem: "Web",
  url: `${SITE_URL}/ferramentas/valor-do-ganho-de-conversao`,
  offers: { "@type": "Offer", price: "0", priceCurrency: "BRL" },
  provider: { "@type": "Organization", name: BRAND_NAME },
};

const schema = [breadcrumbSchema(breadcrumbItems), faqPageSchema(faq), appSchema];
---

<BaseLayout
  title="Quanto Vale Meio Ponto de Conversão? | Calculadora Grátis | Fórmula Mídia"
  description="Melhorar a conversão do site parece um ajuste técnico abstrato — até você ver o número em reais. Calcule o valor de subir 0,5 ponto percentual. Sem código, sem e-mail."
  path="/ferramentas/valor-do-ganho-de-conversao"
  schema={schema}
>
  <Breadcrumbs items={breadcrumbItems} />
  <header class="relative overflow-hidden px-6 pb-6 pt-16 text-center">
    <div class="pointer-events-none absolute -left-24 -top-44 h-[420px] w-[420px] rounded-full bg-[radial-gradient(circle,rgba(228,41,41,.22),transparent_70%)] blur-[80px]"></div>
    <div class="pointer-events-none absolute -right-28 -top-24 h-[380px] w-[380px] rounded-full bg-[radial-gradient(circle,rgba(180,20,20,.18),transparent_70%)] blur-[80px]"></div>
    <div class="relative z-[2] mx-auto max-w-[700px]">
      <a href="/ferramentas" class="mb-6 inline-flex items-center gap-1.5 font-heading text-[13px] font-semibold text-mid no-underline hover:text-ink">← Todas as ferramentas</a>
      <div class="mb-6"><Badge label="Financeiro · Conversão" /></div>
      <h1 class="font-heading text-[clamp(28px,4.4vw,44px)] font-bold leading-[1.12] tracking-tight">
        "Melhorar a conversão" vira <span class="text-red-hi">um número em reais.</span>
      </h1>
      <p class="mx-auto mt-4 max-w-[560px] text-base leading-relaxed text-mid">
        Meio ponto percentual parece pouco — até você ver quanto isso vale no seu tráfego e ticket
        médio, mês após mês.
      </p>
    </div>
  </header>

  <div class="section-light px-6 pb-6 pt-8">
    <div class="mx-auto max-w-[1140px]">
      <ValorGanhoConversao client:load />
      <p class="mx-auto mt-6 max-w-[680px] text-center text-[11.5px] leading-relaxed text-dim">
        Resultados anônimos e agregados podem ser usados em pesquisas públicas sobre o mercado
        brasileiro. Veja a <a href="/privacidade" class="underline underline-offset-2 hover:text-ink">política de privacidade</a>.
      </p>
    </div>
  </div>

  <section class="px-6 pb-24 pt-10">
    <div class="mx-auto max-w-[720px]">
      <h2 class="font-heading text-[clamp(22px,3.2vw,30px)] font-bold leading-tight tracking-tight">
        CRO não é ajuste técnico. É dinheiro parado.
      </h2>
      <div class="mt-6 flex flex-col gap-5 text-[15.5px] leading-relaxed text-mid">
        <p>
          "Otimizar a conversão do site" soa abstrato — parece um item de checklist técnico, não uma
          decisão de negócio. Esta ferramenta traduz isso: pega o tráfego que você já tem e mostra
          quanto meio ponto percentual a mais de conversão vale em reais, mês e ano.
        </p>
        <p>
          É a mesma aritmética do <a href="/ferramentas/simulador-de-funil" class="text-ink underline underline-offset-2">Simulador de Funil</a>,
          aplicada a uma pergunta específica e fácil de decidir: vale investir em melhorar a
          conversão, ou não?
        </p>
        <p class="rounded-card border border-border bg-glass p-5 text-[14px] text-dim">
          <strong class="text-ink">Ressalva.</strong> O cálculo assume tráfego constante — na prática,
          subir conversão às vezes exige mudar a oferta, o que pode afetar o ticket médio.
        </p>
      </div>
    </div>
  </section>

  <LeiaTambem
    href="/blog/por-que-o-site-nao-converte"
    titulo="Por que o site não converte"
    descricao="Fricção, valor da conversão e funil, juntos, mostram onde está o vazamento."
  />
</BaseLayout>
