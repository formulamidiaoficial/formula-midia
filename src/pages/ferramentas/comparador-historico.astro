---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Badge from "../../components/ui/Badge.astro";
import Breadcrumbs from "../../components/ui/Breadcrumbs.astro";
import LeiaTambem from "../../components/ui/LeiaTambem.astro";
import ComparadorHistorico from "../../components/islands/ComparadorHistorico.tsx";
import { breadcrumbSchema, faqPageSchema, SITE_URL, BRAND_NAME, type FaqItem } from "../../data/schema";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Ferramentas", path: "/ferramentas" },
  { name: "Comparador Histórico", path: "/ferramentas/comparador-historico" },
];

const faq: FaqItem[] = [
  { question: "De onde vem esse dado?", answer: "Direto do CrUX History API, da Google — o mesmo dado de usuário real usado pelo Google no ranqueamento, com até 40 semanas de histórico." },
  { question: "Por que meu concorrente aparece 'sem dado suficiente'?", answer: "O CrUX só mede sites com tráfego relevante no Chrome. Sites pequenos ou pouco visitados não entram nesse conjunto." },
  { question: "O que significa 'melhorou' ou 'piorou'?", answer: "Comparamos a primeira e a última semana disponível do período. Se o LCP (tempo de carregamento) caiu, o site melhorou; se subiu, piorou." },
];

const appSchema = {
  "@context": "https://schema.org", "@type": "WebApplication",
  name: "Comparador Histórico de Velocidade",
  applicationCategory: "BusinessApplication", operatingSystem: "Web",
  url: `${SITE_URL}/ferramentas/comparador-historico`,
  offers: { "@type": "Offer", price: "0", priceCurrency: "BRL" },
  provider: { "@type": "Organization", name: BRAND_NAME },
};

const schema = [breadcrumbSchema(breadcrumbItems), faqPageSchema(faq), appSchema];
---

<BaseLayout
  title="Comparador Histórico de Velocidade vs. Concorrentes | Fórmula Mídia"
  description="Compare a velocidade real do seu site com até 3 concorrentes, ao longo de 40 semanas. Dado direto do Google (CrUX History), grátis, sem login."
  path="/ferramentas/comparador-historico"
  schema={schema}
>
  <Breadcrumbs items={breadcrumbItems} />
  <header class="relative overflow-hidden px-6 pb-6 pt-16 text-center">
    <div class="pointer-events-none absolute -left-24 -top-44 h-[420px] w-[420px] rounded-full bg-[radial-gradient(circle,rgba(228,41,41,.16),transparent_70%)] blur-[80px]"></div>
    <div class="relative z-[2] mx-auto max-w-[680px]">
      <a href="/ferramentas" class="mb-6 inline-flex items-center gap-1.5 font-heading text-[13px] font-semibold text-mid no-underline hover:text-ink">← Todas as ferramentas</a>
      <div class="mb-6"><Badge label="Comparador Histórico" /></div>
      <h1 class="font-heading text-[clamp(28px,4.4vw,44px)] font-bold leading-[1.12] tracking-tight">
        Você está <span class="text-red-hi">ganhando ou perdendo</span> velocidade dos concorrentes?
      </h1>
      <p class="mx-auto mt-4 max-w-[540px] text-base leading-relaxed text-mid">
        40 semanas de dado real de usuário, seu site contra até 3 concorrentes — direto da API do Google.
      </p>
    </div>
  </header>

  <div class="px-6 pb-6 pt-8">
    <div class="mx-auto max-w-[1140px]">
      <ComparadorHistorico client:load />
    </div>
  </div>

  <section class="px-6 pb-24 pt-10">
    <div class="mx-auto max-w-[720px]">
      <h2 class="font-heading text-[clamp(22px,3.2vw,30px)] font-bold leading-tight tracking-tight">
        Por que histórico importa mais que foto do momento
      </h2>
      <div class="mt-6 flex flex-col gap-5 text-[15.5px] leading-relaxed text-mid">
        <p>
          Um site pode estar rápido hoje e devagar há 3 meses — ou o contrário. O que importa pro
          Google (e pro seu cliente) é a tendência, não um teste isolado.
        </p>
        <p class="rounded-card border border-border bg-glass p-5 text-[14px] text-dim">
          <strong class="text-ink">Fonte.</strong> CrUX History API, dado 100% oficial do Google.
        </p>
      </div>
    </div>
  </section>

  <LeiaTambem
    href="/blog/seu-site-e-rapido-e-bem-visto-pelo-google"
    titulo="Seu site é rápido e bem visto pelo Google?"
    descricao="Laboratório, histórico e log: o diagnóstico técnico completo do seu site."
  />
</BaseLayout>
