---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Badge from "../../components/ui/Badge.astro";
import Breadcrumbs from "../../components/ui/Breadcrumbs.astro";
import MerVsRoas from "../../components/islands/MerVsRoas.tsx";
import { breadcrumbSchema, faqPageSchema, SITE_URL, BRAND_NAME, type FaqItem } from "../../data/schema";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Ferramentas", path: "/ferramentas" },
  { name: "MER × ROAS", path: "/ferramentas/mer-vs-roas" },
];

const faq: FaqItem[] = [
  { question: "O que é MER?", answer: "Marketing Efficiency Ratio: receita total do caixa dividida pelo investimento total em mídia — olha o negócio inteiro, não o painel de uma plataforma isolada. É conceito consolidado no mercado de e-commerce/DTC, não uma métrica proprietária." },
  { question: "Por que o MER e o ROAS reportado são diferentes?", answer: "O ROAS de cada plataforma só enxerga o que ela consegue atribuir a si mesma — perde venda offline, atribuição cruzada entre canais e efeito do orgânico influenciado por anúncio. O MER olha o caixa todo." },
  { question: "Um gap grande sempre significa fraude ou erro?", answer: "Não necessariamente — pode ser venda que aconteceu fora do funil rastreado (telefone, loja física) ou atribuição multi-canal mal contada. Mas gap muito grande é sinal forte de que vale investigar o rastreio." },
];

const appSchema = {
  "@context": "https://schema.org", "@type": "WebApplication",
  name: "Comparador de MER × ROAS de plataforma",
  applicationCategory: "BusinessApplication", operatingSystem: "Web",
  url: `${SITE_URL}/ferramentas/mer-vs-roas`,
  offers: { "@type": "Offer", price: "0", priceCurrency: "BRL" },
  provider: { "@type": "Organization", name: BRAND_NAME },
};

const schema = [breadcrumbSchema(breadcrumbItems), faqPageSchema(faq), appSchema];
---

<BaseLayout
  title="Calculadora de MER × ROAS de Plataforma | Grátis | Fórmula Mídia"
  description="O Gerenciador mostra um ROAS bonito, mas o caixa mostra outra coisa? Compare com o MER e descubra o tamanho do gap de atribuição. Sem código, sem e-mail."
  path="/ferramentas/mer-vs-roas"
  schema={schema}
>
  <Breadcrumbs items={breadcrumbItems} />
  <header class="relative overflow-hidden px-6 pb-6 pt-16 text-center">
    <div class="pointer-events-none absolute -left-24 -top-44 h-[420px] w-[420px] rounded-full bg-[radial-gradient(circle,rgba(228,41,41,.22),transparent_70%)] blur-[80px]"></div>
    <div class="pointer-events-none absolute -right-28 -top-24 h-[380px] w-[380px] rounded-full bg-[radial-gradient(circle,rgba(180,20,20,.18),transparent_70%)] blur-[80px]"></div>
    <div class="relative z-[2] mx-auto max-w-[700px]">
      <a href="/ferramentas" class="mb-6 inline-flex items-center gap-1.5 font-heading text-[13px] font-semibold text-mid no-underline hover:text-ink">← Todas as ferramentas</a>
      <div class="mb-6"><Badge label="Financeiro · Atribuição" /></div>
      <h1 class="font-heading text-[clamp(28px,4.4vw,44px)] font-bold leading-[1.12] tracking-tight">
        O painel mostra uma coisa. <span class="text-red-hi">O caixa mostra outra.</span>
      </h1>
      <p class="mx-auto mt-4 max-w-[560px] text-base leading-relaxed text-mid">
        O ROAS que a plataforma reporta só enxerga o que ela consegue atribuir a si mesma. Compare
        com o MER — a eficiência real, vista do caixa — e veja o tamanho do gap.
      </p>
    </div>
  </header>

  <div class="section-light px-6 pb-6 pt-8">
    <div class="mx-auto max-w-[1140px]">
      <MerVsRoas client:load />
      <p class="mx-auto mt-6 max-w-[680px] text-center text-[11.5px] leading-relaxed text-dim">
        Resultados anônimos e agregados podem ser usados em pesquisas públicas sobre o mercado
        brasileiro. Veja a <a href="/privacidade" class="underline underline-offset-2 hover:text-ink">política de privacidade</a>.
      </p>
    </div>
  </div>

  <section class="px-6 pb-24 pt-10">
    <div class="mx-auto max-w-[720px]">
      <h2 class="font-heading text-[clamp(22px,3.2vw,30px)] font-bold leading-tight tracking-tight">
        Onde o gap de atribuição se esconde
      </h2>
      <div class="mt-6 flex flex-col gap-5 text-[15.5px] leading-relaxed text-mid">
        <p>
          Cada plataforma de mídia tem incentivo (e limitação técnica) pra reportar o ROAS mais alto
          que conseguir provar. O MER ignora essa disputa: olha só duas coisas, quanto entrou no
          caixa e quanto saiu em mídia — não importa qual canal "levou o crédito".
        </p>
        <p>
          Um gap pequeno (abaixo de 15%) é normal. Um gap grande (acima de 40%) é sinal forte de que
          vale auditar o rastreio — venda offline não contada, pixel quebrado, atribuição cruzada
          entre plataformas.
        </p>
        <p class="rounded-card border border-border bg-glass p-5 text-[14px] text-dim">
          <strong class="text-ink">Ressalva.</strong> O MER mistura todos os canais — não isola qual
          campanha específica está com problema. Serve pra saúde geral, não pra diagnóstico
          campanha a campanha.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
