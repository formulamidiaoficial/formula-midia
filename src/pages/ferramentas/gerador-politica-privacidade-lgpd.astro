---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Badge from "../../components/ui/Badge.astro";
import Breadcrumbs from "../../components/ui/Breadcrumbs.astro";
import GeradorLgpd from "../../components/islands/GeradorLgpd.tsx";
import { breadcrumbSchema, faqPageSchema, SITE_URL, BRAND_NAME, type FaqItem } from "../../data/schema";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Ferramentas", path: "/ferramentas" },
  { name: "Gerador de Política de Privacidade (LGPD)", path: "/ferramentas/gerador-politica-privacidade-lgpd" },
];

const faq: FaqItem[] = [
  { question: "Isto substitui um advogado?", answer: "Não. É um modelo orientativo com base na LGPD, preenchido com o que você informou — não é geração por IA de texto jurídico novo. Antes de publicar, um advogado deve revisar o documento." },
  { question: "Meus dados ficam salvos em algum servidor?", answer: "Não. O documento é gerado inteiramente no seu navegador — nada do que você digita é armazenado pela Fórmula Mídia." },
  { question: "Que casos essa ferramenta não cobre?", answer: "Dado de saúde ou outro dado sensível, transferência internacional de dados, e a obrigatoriedade de um Encarregado de Dados (DPO) formal — que depende do porte e atividade da empresa. Se algum se aplica ao seu negócio, procure um advogado antes de publicar." },
  { question: "Por que preciso marcar o que o site coleta em vez de escrever livremente?", answer: "Pra evitar que o documento inclua coleta que você não faz de verdade (ou esqueça uma que faz). O checklist garante que o texto gerado reflita exatamente o que foi marcado." },
];

const appSchema = {
  "@context": "https://schema.org", "@type": "WebApplication",
  name: "Gerador de Política de Privacidade (LGPD)",
  applicationCategory: "BusinessApplication", operatingSystem: "Web",
  url: `${SITE_URL}/ferramentas/gerador-politica-privacidade-lgpd`,
  offers: { "@type": "Offer", price: "0", priceCurrency: "BRL" },
  provider: { "@type": "Organization", name: BRAND_NAME },
};

const schema = [breadcrumbSchema(breadcrumbItems), faqPageSchema(faq), appSchema];
---

<BaseLayout
  title="Gerador de Política de Privacidade (LGPD) | Grátis | Fórmula Mídia"
  description="Muito site pequeno não tem política de privacidade — ou usa um texto genérico copiado. Gere um modelo alinhado à LGPD com o que o seu site realmente coleta. Sem código, sem e-mail."
  path="/ferramentas/gerador-politica-privacidade-lgpd"
  schema={schema}
>
  <Breadcrumbs items={breadcrumbItems} />
  <header class="relative overflow-hidden px-6 pb-6 pt-16 text-center">
    <div class="pointer-events-none absolute -left-24 -top-44 h-[420px] w-[420px] rounded-full bg-[radial-gradient(circle,rgba(228,41,41,.22),transparent_70%)] blur-[80px]"></div>
    <div class="pointer-events-none absolute -right-28 -top-24 h-[380px] w-[380px] rounded-full bg-[radial-gradient(circle,rgba(180,20,20,.18),transparent_70%)] blur-[80px]"></div>
    <div class="relative z-[2] mx-auto max-w-[700px]">
      <a href="/ferramentas" class="mb-6 inline-flex items-center gap-1.5 font-heading text-[13px] font-semibold text-mid no-underline hover:text-ink">← Todas as ferramentas</a>
      <div class="mb-6"><Badge label="Jurídico · LGPD" /></div>
      <h1 class="font-heading text-[clamp(28px,4.4vw,44px)] font-bold leading-[1.12] tracking-tight">
        Seu site coleta dado. <span class="text-red-hi">Sua política reflete isso?</span>
      </h1>
      <p class="mx-auto mt-4 max-w-[560px] text-base leading-relaxed text-mid">
        Muito site pequeno não tem política de privacidade, ou usa um texto genérico copiado que não
        bate com o que o site realmente coleta. Gere um modelo alinhado à LGPD em minutos.
      </p>
    </div>
  </header>

  <div class="section-light px-6 pb-6 pt-8">
    <div class="mx-auto max-w-[1140px]">
      <GeradorLgpd client:load />
      <p class="mx-auto mt-6 max-w-[680px] text-center text-[11.5px] leading-relaxed text-dim">
        Resultados anônimos e agregados podem ser usados em pesquisas públicas sobre o mercado
        brasileiro. Veja a <a href="/privacidade" class="underline underline-offset-2 hover:text-ink">política de privacidade</a>.
      </p>
    </div>
  </div>

  <section class="px-6 pb-24 pt-10">
    <div class="mx-auto max-w-[720px]">
      <h2 class="font-heading text-[clamp(22px,3.2vw,30px)] font-bold leading-tight tracking-tight">
        Um modelo orientativo, não uma peça jurídica pronta
      </h2>
      <div class="mt-6 flex flex-col gap-5 text-[15.5px] leading-relaxed text-mid">
        <p>
          Este gerador preenche uma estrutura padrão (dados coletados, finalidade, base legal,
          compartilhamento com terceiros, retenção, direitos do titular, contato) com exatamente o
          que você marcou — nada é inventado, nada é gerado por IA como texto jurídico novo.
        </p>
        <p>
          Não é geração por IA de texto jurídico novo — é preenchimento de template com o que você
          informou, seguindo a estrutura da <strong class="text-ink">Lei nº 13.709/2018 (LGPD)</strong>.
        </p>
        <p class="rounded-card border border-red/40 bg-red/10 p-5 text-[14px] text-ink">
          <strong>Isto não é assessoria jurídica.</strong> Antes de publicar, um profissional
          habilitado (advogado) deve revisar o documento gerado — a Fórmula Mídia não se
          responsabiliza pela adequação legal do texto sem essa revisão.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
