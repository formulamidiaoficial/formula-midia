---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/ui/Breadcrumbs.astro";
import { breadcrumbSchema, itemListSchema, SITE_URL } from "../../data/schema";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog" },
];

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.datePublished.valueOf() - a.data.datePublished.valueOf()
);

const listSchema = itemListSchema(
  posts.map((post) => ({ name: post.data.title, url: `${SITE_URL}/blog/${post.id}` }))
);

const schema = [breadcrumbSchema(breadcrumbItems), listSchema];
---

<BaseLayout
  title="Blog — Growth, Tráfego Pago e SEO/GEO | Fórmula Mídia"
  description="Guias completos sobre CAC, LTV, conversão, GEO e performance técnica — conectados direto às ferramentas gratuitas da Fórmula Mídia."
  path="/blog"
  schema={schema}
>
  <Breadcrumbs items={breadcrumbItems} />
  <header class="relative overflow-hidden px-6 pb-6 pt-16 text-center">
    <div class="pointer-events-none absolute -left-24 -top-44 h-[420px] w-[420px] rounded-full bg-[radial-gradient(circle,rgba(228,41,41,.22),transparent_70%)] blur-[80px]"></div>
    <div class="relative z-[2] mx-auto max-w-[700px]">
      <h1 class="font-heading text-[clamp(28px,4.4vw,44px)] font-bold leading-[1.12] tracking-tight">
        Blog <span class="text-red-hi">Fórmula Mídia</span>
      </h1>
      <p class="mx-auto mt-4 max-w-[560px] text-base leading-relaxed text-mid">
        Guias completos que ensinam o que as nossas ferramentas gratuitas calculam — pra você
        entender o número, não só ver o resultado.
      </p>
      <a href="/blog/rss.xml" class="mt-4 inline-flex items-center gap-1.5 font-heading text-[12px] font-semibold text-dim no-underline hover:text-ink">
        RSS →
      </a>
    </div>
  </header>

  <section class="px-6 pb-24 pt-6">
    <div class="mx-auto grid max-w-[900px] gap-5 sm:grid-cols-2">
      {posts.map((post) => (
        <a
          href={`/blog/${post.id}`}
          class="rounded-card border border-border bg-glass p-7 no-underline transition-colors hover:border-border-hi"
        >
          <div class="mb-2 font-heading text-[11px] font-semibold uppercase tracking-[.08em] text-red-hi">
            Pilar {post.data.pilar}
          </div>
          <div class="mb-2 font-heading text-[17px] font-semibold leading-snug text-ink">{post.data.title}</div>
          <p class="text-[13.5px] leading-relaxed text-mid">{post.data.description}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
