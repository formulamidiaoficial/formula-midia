---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/ui/Breadcrumbs.astro";
import FaqAccordion from "../../components/ui/FaqAccordion.astro";
import { breadcrumbSchema, faqPageSchema, SITE_URL, BRAND_NAME } from "../../data/schema";
import { FERRAMENTAS } from "../../data/ferramentas";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const allPosts = await getCollection("blog");
const artigosRelacionados = allPosts.filter((p) => post.data.artigosRelacionados.includes(p.id));
const ferramentasRelacionadas = FERRAMENTAS.filter((f) =>
  post.data.ferramentasRelacionadas.includes(f.slug)
);

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog" },
  { name: post.data.title, path: `/blog/${post.id}` },
];

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.datePublished.toISOString(),
  dateModified: (post.data.dateModified ?? post.data.datePublished).toISOString(),
  author: { "@type": "Organization", name: BRAND_NAME },
  publisher: { "@type": "Organization", name: BRAND_NAME, logo: { "@type": "ImageObject", url: `${SITE_URL}/assets/logo.png` } },
  mainEntityOfPage: `${SITE_URL}/blog/${post.id}`,
};

const schema = [breadcrumbSchema(breadcrumbItems), articleSchema];
if (post.data.faq.length > 0) schema.push(faqPageSchema(post.data.faq));
---

<BaseLayout
  title={`${post.data.title} | Fórmula Mídia`}
  description={post.data.description}
  path={`/blog/${post.id}`}
  schema={schema}
  type="article"
  publishedTime={post.data.datePublished.toISOString()}
  modifiedTime={(post.data.dateModified ?? post.data.datePublished).toISOString()}
>
  <Breadcrumbs items={breadcrumbItems} />

  <article class="px-6 pb-16 pt-14">
    <div class="mx-auto max-w-[720px]">
      <div class="mb-4 font-heading text-xs font-semibold uppercase tracking-[.1em] text-red-hi">
        Pilar {post.data.pilar}
      </div>
      <h1 class="font-heading text-[clamp(28px,4.6vw,42px)] font-bold leading-[1.12] tracking-tight">
        {post.data.title}
      </h1>
      <p class="mt-5 text-[17px] leading-relaxed text-mid">{post.data.description}</p>

      <div class="prose-article mt-10 flex flex-col gap-5 text-[15.5px] leading-relaxed text-mid [&_h2]:mt-4 [&_h2]:font-heading [&_h2]:text-[24px] [&_h2]:font-bold [&_h2]:leading-tight [&_h2]:text-ink [&_a]:text-ink [&_a]:underline [&_a]:underline-offset-2 [&_code]:text-[13px] [&_pre]:overflow-x-auto [&_pre]:rounded-2xl [&_pre]:border [&_pre]:border-border [&_pre]:bg-glass [&_pre]:p-5 [&_pre]:text-[13px] [&_strong]:text-ink">
        <Content />
      </div>

      {post.data.faq.length > 0 && (
        <div class="mt-14">
          <h2 class="mb-2 font-heading text-[22px] font-bold text-ink">Perguntas frequentes</h2>
          <FaqAccordion items={post.data.faq} />
        </div>
      )}

      {ferramentasRelacionadas.length > 0 && (
        <div class="mt-14 rounded-card border border-red/28 bg-gradient-to-b from-red/8 to-glass p-7">
          <h2 class="mb-4 font-heading text-xs font-semibold uppercase tracking-[.1em] text-red-hi">
            Calcule ou verifique isso agora
          </h2>
          <div class="grid gap-3 sm:grid-cols-2">
            {ferramentasRelacionadas.map((f) => (
              <a
                href={`/ferramentas/${f.slug}`}
                class="rounded-2xl border border-border bg-glass p-5 no-underline transition-colors hover:border-border-hi"
              >
                <div class="font-heading text-[14.5px] font-semibold text-ink">{f.nome} →</div>
                <div class="mt-1 text-[12.5px] leading-relaxed text-mid">{f.desc}</div>
              </a>
            ))}
          </div>
        </div>
      )}

      {artigosRelacionados.length > 0 && (
        <div class="mt-10">
          <h2 class="mb-4 font-heading text-[13px] font-semibold uppercase tracking-[.08em] text-dim">
            Leia também
          </h2>
          <div class="grid gap-3 sm:grid-cols-2">
            {artigosRelacionados.map((p) => (
              <a href={`/blog/${p.id}`} class="rounded-card border border-border bg-glass p-5 no-underline transition-colors hover:border-border-hi">
                <div class="font-heading text-[14px] font-semibold text-ink">{p.data.title}</div>
              </a>
            ))}
          </div>
        </div>
      )}

      <a href="/blog" class="mt-12 inline-flex items-center gap-1.5 font-heading text-[13px] font-semibold text-mid no-underline hover:text-ink">
        ← Todos os artigos
      </a>
    </div>
  </article>
</BaseLayout>
