---
import BaseLayout from "../layouts/BaseLayout.astro";
import Badge from "../components/ui/Badge.astro";
import Breadcrumbs from "../components/ui/Breadcrumbs.astro";
import { waLink, breadcrumbSchema, SITE_URL, BRAND_NAME } from "../data/schema";
import { SERVICOS } from "../data/servicos";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Soluções", path: "/solucoes" },
];

const ctaMessage = "Olá! Vi as soluções da Fórmula Mídia e quero conversar.";

const offerSchema = {
  "@context": "https://schema.org",
  "@type": "OfferCatalog",
  name: "Soluções produtizadas — Fórmula Mídia",
  provider: { "@type": "Organization", name: BRAND_NAME },
  itemListElement: SERVICOS.map((s) => ({
    "@type": "Offer",
    name: s.nome,
    priceCurrency: "BRL",
    price: s.preco.replace(/[^\d]/g, ""),
    url: `${SITE_URL}/solucoes`,
  })),
};

const schema = [breadcrumbSchema(breadcrumbItems), offerSchema];
---

<BaseLayout
  title="Soluções — escopo fixo, preço fixo, prazo | Fórmula Mídia"
  description="Diagnóstico grátis, execução paga. Consertos com escopo fechado, preço visível e prazo prometido — do custo real da mídia ao SEO técnico. Sem 'sob consulta'."
  path="/solucoes"
  schema={schema}
>
  <Breadcrumbs items={breadcrumbItems} />
  <header class="relative overflow-hidden px-6 pb-6 pt-16 text-center">
    <div class="pointer-events-none absolute -left-24 -top-44 h-[420px] w-[420px] rounded-full bg-[radial-gradient(circle,rgba(228,41,41,.22),transparent_70%)] blur-[80px]"></div>
    <div class="pointer-events-none absolute -right-28 -top-24 h-[380px] w-[380px] rounded-full bg-[radial-gradient(circle,rgba(180,20,20,.18),transparent_70%)] blur-[80px]"></div>
    <div class="relative z-[2] mx-auto max-w-[720px]">
      <div class="mb-6"><Badge label="Soluções" /></div>
      <h1 class="font-heading text-[clamp(28px,4.4vw,44px)] font-bold leading-[1.12] tracking-tight">
        O diagnóstico é grátis. O <span class="text-red-hi">conserto tem escopo e preço.</span>
      </h1>
      <p class="mx-auto mt-4 max-w-[560px] text-base leading-relaxed text-mid">
        As ferramentas mostram o problema de graça. Aqui está o conserto — com escopo fechado, preço
        visível e prazo prometido. Sem "sob consulta": você sabe o que leva, quanto custa e quando fica pronto.
      </p>
    </div>
  </header>

  <section class="section-light px-6 pb-24 pt-8">
    <div class="mx-auto grid max-w-[1120px] gap-6 md:grid-cols-2">
      {SERVICOS.map((s) => (
        <div class="flex flex-col rounded-card border border-border bg-glass p-7">
          <span class="mb-2 font-heading text-[10.5px] font-semibold uppercase tracking-[.11em] text-red-hi">{s.tag}</span>
          <h2 class="mb-2 font-heading text-[20px] font-bold leading-snug text-ink">{s.nome}</h2>
          <p class="mb-4 text-[13.8px] leading-relaxed text-mid">{s.conserta}</p>

          <div class="mb-5 flex flex-col gap-2">
            {s.incluso.map((item) => (
              <div class="flex gap-2.5 text-[13.5px] leading-snug text-mid">
                <span class="font-bold text-red-hi">✓</span><span>{item}</span>
              </div>
            ))}
          </div>

          <div class="mt-auto">
            <div class="mb-4 flex items-baseline justify-between gap-3 border-t border-border pt-4">
              <span class="text-[12px] uppercase tracking-[.06em] text-dim">{s.prazo}</span>
              <span class="font-heading text-[24px] font-bold text-ink">{s.preco}</span>
            </div>
            <a
              href={waLink(s.waMsg + " [ref: solucoes]")}
              target="_blank"
              rel="noopener"
              class="flex w-full items-center justify-center gap-2 rounded-full bg-gradient-to-br from-red to-red-lo px-4 py-3.5 font-heading text-[14px] font-semibold text-white no-underline shadow-[0_10px_30px_rgba(228,41,41,0.30)] transition-transform hover:-translate-y-0.5"
            >
              Quero este serviço →
            </a>
            {s.ferramentaSlug && (
              <a href={`/ferramentas/${s.ferramentaSlug}`} class="mt-3 block text-center text-[12.5px] text-dim no-underline hover:text-ink">
                Antes: rode o diagnóstico grátis — {s.ferramentaNome} →
              </a>
            )}
          </div>
        </div>
      ))}
    </div>

    <div class="mx-auto mt-10 max-w-[720px] rounded-card border border-red/25 bg-red/6 p-7 text-center">
      <p class="text-[15px] leading-relaxed text-ink">
        <strong>Precisa de mais que um conserto pontual?</strong> Quando o objetivo é crescer de forma
        contínua — tráfego, CRM e dados sob um método e um gestor dedicado — a conversa é de
        <a href="/growth" class="font-semibold text-red-hi underline underline-offset-2">Growth &amp; Performance</a>.
      </p>
      <a
        href={waLink(ctaMessage)}
        target="_blank"
        rel="noopener"
        class="mt-5 inline-flex items-center justify-center gap-2 rounded-full border border-ink px-6 py-3 font-heading text-[14px] font-semibold text-ink no-underline transition-colors hover:bg-ink hover:text-white"
      >
        Falar com um especialista →
      </a>
    </div>
  </section>
</BaseLayout>
